# Tapo C210 kamera beállításai
# Másold ezt a fájlt .env névre és töltsd ki az adatokkal:
#   cp .env.example .env

# A kamera IP-címe a helyi hálózaton
TAPO_IP=192.168.1.100

# Tapo fiók e-mail cím (amivel a Tapo appban regisztráltál)
TAPO_USER=email@example.com

# Tapo fiók jelszó
TAPO_PASSWORD=your_password_here

# Lejátszandó MP3 fájl elérési útja (alapértelmezett: music/sample.mp3)
MUSIC_FILE=music/sample.mp3
